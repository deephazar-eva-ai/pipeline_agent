# Copy to .env and fill in. Never commit .env.
#
# AGENTSWITCH_MCP_URL / AGENTSWITCH_MCP_TOKEN are placeholders: the exact MCP
# transport and auth contract for AgentSwitch has not been confirmed yet
# (see docs/open_items.md, item 4). Fill these in once that contract lands;
# until then RealMCPClient will refuse to run with a clear error rather than
# guess at a wire format.
AGENTSWITCH_MCP_URL=
AGENTSWITCH_MCP_TOKEN=
AGENTSWITCH_TENANT=suryodaya

# Pluggable model backend. runner.py only needs an async callable of
# (prompt, system) -> str; how that's implemented (Ollama, Anthropic, Gemini,
# ...) is a runner-level choice, not a harness dependency.
MODEL_NAME=

OUTPUT_DIR=runs
