# Copy to .env and fill in. Never commit .env.
#
# Base URL and bearer token for AgentSwitch. The client POSTs JSON-RPC 2.0 to
# {AGENTSWITCH_MCP_URL}/api/mcp and sends the standard MCP initialize handshake.
AGENTSWITCH_MCP_URL=
AGENTSWITCH_MCP_TOKEN=
AGENTSWITCH_TENANT=suryodaya

# `generic` is the seat-specific 13-tool catalogue used by this workflow.
# Set `entity_scoped` only for credentials that expose names such as Deal.list.
# That surface cannot express the aggregate report required by the canonical
# workflow, so the agent will fail closed with a clear message at that call.
MCP_TOOL_SURFACE=generic

# Pluggable model backend. runner.py only needs an async callable of
# (prompt, system) -> str; how that's implemented (Ollama, Anthropic, Gemini,
# ...) is a runner-level choice, not a harness dependency.
MODEL_NAME=

OUTPUT_DIR=runs
